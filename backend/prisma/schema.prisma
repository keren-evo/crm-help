datasource db {
  provider = "postgresql" // change to "sqlite" for quick local dev if preferred
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Priority {
  Low
  Medium
  High
}

enum Status {
  Submitted
  InProgress
  Resolved
  Closed
}

model Ticket {
  ticket_id               String   @id
  date_submitted          DateTime @default(now())
  full_name               String
  email                   String
  department              String
  company_affiliation     String
  category                String
  priority                Priority
  issue_title             String
  issue_description       String
  screenshot_file         String?
  error_link              String?
  status                  Status   @default(Submitted)
  assigned_to             String?
  internal_notes          String?
  public_resolution_notes String?
  date_resolved           DateTime?
  last_updated            DateTime @updatedAt
  escalated_to_it         Boolean  @default(false)
  solved_without_it       Boolean  @default(false)

  @@index([email])
}

model Counter {
  id    Int    @id @default(autoincrement())
  name  String @unique
  value Int    @default(0)
}
